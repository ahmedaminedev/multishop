# MultiShop Network Environment Variables
PORT=3000
NODE_ENV=development

# Frontend & Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Database (optional - in-memory mocks active by default in AI Studio)
MONGO_URI=mongodb://localhost:27017/multishop

# Mailer configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=MultiShop Network
FROM_EMAIL=noreply@multishop.tn

# Payment Gateway
PAYMEE_API_KEY=
